rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── users/{uid} ─────────────────────────────────────────────
    // A student can only read/write their OWN profile doc. This is
    // what the single-device lock and the year/semester field rely
    // on - without this rule, claimDevice()/verifyDevice() silently
    // fail (fails open) and the lock does nothing.
    //
    // Admin gets full read/write here too - needed for the "View All
    // Users" list, disabling an account, and account deletion (which
    // overwrites this doc rather than removing it - see
    // adminAccountActions.js for why).
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in ['admin.med101@gmail.com', 'admin1.med101@gmail.com'];
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // ── users/{uid}/quizHistory/{entryId} ──────────────────────
    // A student's own quiz history - only they (or admin) can read
    // or write it. Admin write is used only to delete these when an
    // account is deleted.
    match /users/{uid}/quizHistory/{entryId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // ── users/{uid}/friends/{friendUid} ──────────────────────────
    // A student's own friends/watchlist — one-directional (adding
    // someone doesn't touch their data), so purely self-owned. Admin
    // write is used only to delete these when an account is deleted.
    match /users/{uid}/friends/{friendUid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // ── users/{uid}/wrongQuestions/{key} and .../flaggedQuestions/{key} ──
    // A student's own review queues - purely personal, only the owner
    // (or admin, for account-deletion cleanup) can read or write them.
    match /users/{uid}/wrongQuestions/{key} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }
    match /users/{uid}/flaggedQuestions/{key} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // ── users/{uid}/myRooms/{code} ───────────────────────────────
    // A student's own Challenge Room history - purely personal, so
    // only the owner (or admin, for account-deletion cleanup) can
    // read or write it.
    match /users/{uid}/myRooms/{code} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // ── users/{uid}/invites/{inviteId} ──────────────────────────
    // A student's incoming Challenge invites - like a mailbox. The
    // owner (recipient) can read/delete their own invites. Anyone
    // signed in can CREATE an invite into someone else's mailbox
    // (that's how sending an invite works), but only if the fromUid
    // field matches their own uid - so an invite can never be spoofed
    // as coming from someone else. Admin read/delete is used only for
    // account-deletion cleanup.
    match /users/{uid}/invites/{inviteId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // ── leaderboard/{uid} ───────────────────────────────────────
    // Anyone signed in can READ the leaderboard (it's meant to be
    // seen by everyone), but a student can only write their OWN
    // entry - never someone else's score. Admin write is used only to
    // remove an entry when an account is deleted.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // (Firestore-backed question storage removed - questions are now
    // served entirely from static JSON files bundled with the app, to
    // eliminate the read/write cost of the old admin-editable system.)

    // ── rooms/{code} ────────────────────────────────────────────
    // Challenge Rooms: any signed-in student can create a room (the
    // host's uid must match their own auth uid), and any signed-in
    // student can read a room to join it via its 8-digit code. The
    // room itself is immutable after creation - no update/delete -
    // so a shared question set can never be tampered with mid-challenge.
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── rooms/{code}/participants/{uid} ─────────────────────────
    // Anyone signed in can read the participant list (that's the
    // shared results leaderboard), but each participant can only
    // write their OWN doc - never someone else's score.
    match /rooms/{code}/participants/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── presence/{uid} ────────────────────────────────────────────
    // Lightweight "who's online" heartbeat. Anyone signed in can read
    // the whole collection (needed to count how many are online), but
    // each student can only write their own presence doc.
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── usernames/{normalizedName} ───────────────────────────────
    // Backs unique username claims - the normalized name IS the doc
    // ID, so Firestore itself guarantees no two students can claim
    // the same one. Anyone signed in can read (to check availability
    // before claiming), but a doc can only be created/updated/deleted
    // by the uid it already belongs to (or, for a brand-new claim, by
    // whoever is creating it - enforced by requiring the new doc's own
    // uid field to match the writer). Admin delete is used only for
    // account-deletion cleanup (freeing up the username).
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.uid == request.auth.uid && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── config/{docId} ──────────────────────────────────────────
    // Home notice, leaderboard default scope, academic calendar,
    // etc. Everyone signed in can read (the app needs these to
    // render), only admin can write.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
