rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in ['admin.med101@gmail.com', 'admin1.med101@gmail.com', 'admin2.med101@gmail.com'];
    }

    // ── users/{uid} ─────────────────────────────────────────────
    // A student can only read/write their OWN profile doc. This is
    // what the single-device lock and the year/semester field rely
    // on - without this rule, claimDevice()/verifyDevice() silently
    // fail (fails open) and the lock does nothing.
    //
    // create vs update are split deliberately: create (signup's very
    // first setDoc, when no doc exists yet) is unrestricted for the
    // owner, but update blocks the student from ever touching
    // `disabled` themselves - without this split, a disabled student
    // could simply reactivate their own account via dev tools/a raw
    // Firestore write, which defeats the whole point of that feature.
    // (Premium status is deliberately NOT stored as a writable field
    // here at all - see activationCodes below for why.)
    //
    // Admin gets full read/write here too - needed for the "View All
    // Users" list, disabling an account, and account deletion (which
    // overwrites this doc rather than removing it - see
    // adminAccountActions.js for why).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['disabled']);
      allow read, write: if isAdmin();
    }

    // ── users/{uid}/quizHistory/{entryId} ──────────────────────
    // A student's own quiz history - only they (or admin) can read
    // or write it. Admin write is used only to delete these when an
    // account is deleted.
    //
    // create additionally requires the entry's deviceId to match the
    // account's current activeDeviceId - this is the server-side
    // backstop for the single-device lock: the client-side "kick" is
    // a push (onSnapshot) that can't reach a genuinely offline
    // device, so without this a stale device that goes offline right
    // as another device signs in could keep submitting quiz results
    // under the same account indefinitely. This only blocks NEW
    // results from a stale device - it doesn't touch read/update/
    // delete of already-saved entries.
    match /users/{uid}/quizHistory/{entryId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.deviceId == get(/databases/$(database)/documents/users/$(uid)).data.activeDeviceId;
      allow read, write: if isAdmin();
    }

    // ── users/{uid}/friends/{friendUid} ──────────────────────────
    // A student's own friends/watchlist — one-directional (adding
    // someone doesn't touch their data), so purely self-owned. Admin
    // write is used only to delete these when an account is deleted.
    match /users/{uid}/friends/{friendUid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // ── users/{uid}/wrongQuestions/{key} and .../flaggedQuestions/{key} ──
    // A student's own review queues - purely personal, only the owner
    // (or admin, for account-deletion cleanup) can read or write them.
    match /users/{uid}/wrongQuestions/{key} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }
    match /users/{uid}/flaggedQuestions/{key} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // ── users/{uid}/myRooms/{code} ───────────────────────────────
    // A student's own Challenge Room history - purely personal, so
    // only the owner (or admin, for account-deletion cleanup) can
    // read or write it.
    match /users/{uid}/myRooms/{code} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // ── users/{uid}/invites/{inviteId} ──────────────────────────
    // A student's incoming Challenge invites - like a mailbox. The
    // owner (recipient) can read/delete their own invites. Anyone
    // signed in can CREATE an invite into someone else's mailbox
    // (that's how sending an invite works), but only if the fromUid
    // field matches their own uid - so an invite can never be spoofed
    // as coming from someone else. Admin read/delete is used only for
    // account-deletion cleanup.
    match /users/{uid}/invites/{inviteId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow read, write: if isAdmin();
    }

    // ── leaderboard/{uid} ───────────────────────────────────────
    // Anyone signed in can READ the leaderboard (it's meant to be
    // seen by everyone), but a student can only write their OWN
    // entry - never someone else's score. Admin write is used only to
    // remove an entry when an account is deleted.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // (Firestore-backed question storage removed - questions are now
    // served entirely from static JSON files bundled with the app, to
    // eliminate the read/write cost of the old admin-editable system.)

    // ── paymentRequests/{utr} ────────────────────────────────────
    // A student's premium-purchase submission (manual UPI flow - see
    // subscription.js). Doc ID is the UTR/transaction ID itself, which
    // is what naturally blocks a duplicate submission of the same
    // transaction: a second create attempt on an ID that already
    // exists is an UPDATE in Firestore's eyes, not a create, and
    // students have no update permission here at all - only admin can
    // transition a request's status.
    match /paymentRequests/{utr} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow get, list: if request.auth != null && resource.data.uid == request.auth.uid;
      allow get, list: if isAdmin();
      allow update: if isAdmin();
    }

    // ── activationCodes/{code} ────────────────────────────────────
    // The premium redemption codes themselves. Deliberately the ONLY
    // source of truth for premium status - there is no `premiumUntil`
    // (or similar) field a student can write on their own users/{uid}
    // doc, because that would let anyone grant themselves premium via
    // a raw Firestore write from dev tools. Instead, premium status is
    // computed client-side by reading a student's own USED codes and
    // taking the latest (usedAt + durationDays) - since a code can only
    // ever be created by admin, and can only be flipped from unused to
    // used exactly once by its rightful owner, there is no way for a
    // student to fabricate a valid "used" code for themselves.
    match /activationCodes/{code} {
      allow create: if isAdmin();
      allow get, list: if request.auth != null && resource.data.uid == request.auth.uid;
      allow get, list: if isAdmin();
      allow delete: if isAdmin();
      // The one-time redemption transition: only the code's rightful
      // owner, only while it's still unused, only flipping it to used
      // and stamping who/when - nothing else about the code (uid,
      // durationDays, the code's own identity) can be changed.
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && resource.data.used == false
                    && request.resource.data.used == true
                    && request.resource.data.usedBy == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedAt', 'usedBy']);
    }

    // ── rooms/{code} ────────────────────────────────────────────
    // Challenge Rooms: any signed-in student can create a room (the
    // host's uid must match their own auth uid), and any signed-in
    // student can read a room to join it via its 8-digit code. The
    // room itself is immutable after creation - no update/delete -
    // so a shared question set can never be tampered with mid-challenge.
    match /rooms/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── rooms/{code}/participants/{uid} ─────────────────────────
    // Anyone signed in can read the participant list (that's the
    // shared results leaderboard), but each participant can only
    // write their OWN doc - never someone else's score.
    match /rooms/{code}/participants/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── presence/{uid} ────────────────────────────────────────────
    // Lightweight "who's online" heartbeat. Anyone signed in can read
    // the whole collection (needed to count how many are online), but
    // each student can only write their own presence doc.
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── usernames/{normalizedName} ───────────────────────────────
    // Backs unique username claims - the normalized name IS the doc
    // ID, so Firestore itself guarantees no two students can claim
    // the same one. Anyone signed in can read (to check availability
    // before claiming), but a doc can only be created/updated/deleted
    // by the uid it already belongs to (or, for a brand-new claim, by
    // whoever is creating it - enforced by requiring the new doc's own
    // uid field to match the writer). Admin delete is used only for
    // account-deletion cleanup (freeing up the username).
    match /usernames/{name} {
      // Public GET only (not list) - lets the signup form check one
      // specific name's availability without being signed in yet, but
      // does NOT allow anyone to query/dump the whole collection (that
      // would hand out every username-to-uid mapping in one request,
      // which is a real exposure regardless of how sensitive a single
      // uid is on its own - nothing in this app ever needs to list
      // this collection, only look up one exact name at a time, so
      // there's no feature cost to blocking list entirely).
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.uid == request.auth.uid && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── config/{docId} ──────────────────────────────────────────
    // Home notice, leaderboard default scope, academic calendar,
    // subscription price/UPI details, etc. Everyone signed in can
    // read (the app needs these to render), only admin can write.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Default deny for anything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
