# Vercel server-side environment variables
# Never commit the real values.
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_CHAT_ID=replace_with_your_telegram_chat_id
FIREBASE_WEB_API_KEY=replace_with_your_firebase_web_api_key

# Gemini AI explanations
GEMINI_API_KEY=replace_with_google_ai_studio_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_DAILY_GENERATION_LIMIT=50

# Firebase service account values for the server-side AI cache.
# Copy these from the service-account JSON you download from Firebase.
FIREBASE_PROJECT_ID=med101-1
FIREBASE_CLIENT_EMAIL=replace_with_service_account_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_with_private_key\n-----END PRIVATE KEY-----\n"
